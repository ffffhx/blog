{
  "name": "garden-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @garden-lab/site dev",
    "build": "pnpm --filter @garden-lab/site build",
    "api:dev": "pnpm --filter @garden-lab/api dev",
    "api:start": "pnpm --filter @garden-lab/api start",
    "api:build": "pnpm --filter @garden-lab/api build",
    "export:private": "pnpm --filter @garden-lab/site export:private",
    "start": "pnpm --filter @garden-lab/site start",
    "test": "pnpm --filter @garden-lab/site test && pnpm --filter @garden-lab/api test",
    "test:watch": "pnpm --filter @garden-lab/site test:watch",
    "prepare:public": "pnpm --filter @garden-lab/site prepare:public",
    "sync:assets": "pnpm --filter @garden-lab/site sync:assets",
    "bench:dev": "pnpm --filter @garden-lab/browser-tool-bench dev",
    "new:post": "pnpm --filter @garden-lab/site new:post",
    "new:tech": "pnpm --filter @garden-lab/site new:tech",
    "new:fitness": "pnpm --filter @garden-lab/site new:fitness",
    "new:daily-news": "pnpm --filter @garden-lab/site new:daily-news"
  }
}
